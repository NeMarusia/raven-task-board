{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven Task Board",
  "version": "0.1.0",
  "identifier": "online.marsillia.raven-task-board",
  "build": {
    "beforeDevCommand": "npm run build:desktop-assets",
    "beforeBuildCommand": "npm run build:desktop-assets",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Raven Task Board",
        "width": 1280,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "RTB — cozy kanban task board",
    "longDescription": "Raven Task Board: cozy local kanban with Markdown/Obsidian file sync."
  }
}
